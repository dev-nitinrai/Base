{% comment %} /sections/store-locator.liquid {% endcomment %}
{{ 'section-store-locator.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #store-locator-{{ section.id }} {
    --store-locator-columns: {{ section.settings.cards_per_row }};
  }
{%- endstyle -%}

{%- liquid
  assign store_locations = shop.metaobjects['store_location'].values
-%}

{%- capture cities_json -%}
  [{% for location in store_locations %}"{{ location.city.value | downcase | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- endcapture -%}

<div
  id="store-locator-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} store-locator section-{{ section.id }}-padding"
  x-data="{
    query: '',
    cities: {{ cities_json | strip }},
    get hasResults() {
      const q = this.query.trim().toLowerCase();
      return !q || this.cities.some(function(c) { return c.includes(q); });
    }
  }"
>
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="store-locator__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="store-locator__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="store-locator__search">
      <div class="store-locator__search-wrapper">
        <span class="store-locator__search-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input
          id="store-search-{{ section.id }}"
          type="text"
          x-model="query"
          class="store-locator__search-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search by city…' | escape }}"
          aria-label="Filter stores by city"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        >
        <button
          type="button"
          class="store-locator__search-clear"
          x-show="query.length > 0"
          @click="query = ''"
          aria-label="Clear search"
          x-cloak
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    {%- if store_locations != blank -%}
      <div class="store-locator__grid">
        {%- for location in store_locations -%}
          {%- liquid
            assign loc_name    = location.name.value
            assign loc_address = location.address.value
            assign loc_city    = location.city.value
            assign loc_phone   = location.phone.value
            assign loc_hours   = location.hours.value
            assign loc_lat     = location.latitude.value
            assign loc_lng     = location.longitude.value
            assign loc_city_lc = loc_city | downcase | escape
          -%}
          <article
            class="store-locator__card"
            x-show="!query.trim() || '{{ loc_city_lc }}'.includes(query.trim().toLowerCase())"
            x-transition:leave="store-locator__card--leaving"
            x-transition:leave-end="store-locator__card--hidden"
          >
            <div class="store-locator__card-header">
              <h3 class="store-locator__card-name">{{ loc_name | escape }}</h3>
              {%- if loc_city != blank -%}
                <span class="store-locator__card-city">{{ loc_city | escape }}</span>
              {%- endif -%}
            </div>

            <div class="store-locator__card-body">
              {%- if loc_address != blank -%}
                <div class="store-locator__detail store-locator__detail--address">
                  <span class="store-locator__detail-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  </span>
                  <address class="store-locator__detail-text">{{ loc_address | newline_to_br }}</address>
                </div>
              {%- endif -%}

              {%- if loc_phone != blank -%}
                <div class="store-locator__detail store-locator__detail--phone">
                  <span class="store-locator__detail-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.59 3.42 2 2 0 0 1 3.56 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.9-.9a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2z"/></svg>
                  </span>
                  <a
                    href="tel:{{ loc_phone | escape }}"
                    class="store-locator__detail-text store-locator__detail-link"
                  >{{ loc_phone | escape }}</a>
                </div>
              {%- endif -%}

              {%- if loc_hours != blank -%}
                <div class="store-locator__detail store-locator__detail--hours">
                  <span class="store-locator__detail-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  </span>
                  <div class="store-locator__detail-text">{{ loc_hours | newline_to_br }}</div>
                </div>
              {%- endif -%}
            </div>

            {%- if loc_lat != blank and loc_lng != blank -%}
              <div class="store-locator__card-footer">
                <a
                  href="https://www.google.com/maps?q={{ loc_lat }},{{ loc_lng }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="store-locator__directions-link"
                >
                  Get Directions
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      <p
        class="store-locator__no-results"
        x-cloak
        x-show="query.trim() && !hasResults"
      >
        No stores found matching &ldquo;<span x-text="query"></span>&rdquo;.
      </p>

    {%- else -%}
      {%- if request.design_mode -%}
        <div class="store-locator__setup-notice">
          <p>No store locations found. Please add <strong>store_location</strong> metaobjects in your Shopify admin under <em>Content &rsaquo; Metaobjects</em>.</p>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "store-locator-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Store Near You"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visit us in person at one of our locations."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Search by city…"
    },
    {
      "type": "select",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "settings": {
        "heading": "Find a Store Near You",
        "subheading": "Visit us in person at one of our locations.",
        "cards_per_row": "3",
        "padding_top": 60,
        "padding_bottom": 60
      }
    }
  ]
}
{% endschema %}

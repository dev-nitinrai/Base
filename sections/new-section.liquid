{%- liquid
  assign shades = shop.metaobjects.agent_shade_v3.values
  assign shades_count = shades | size
-%}

{%- style -%}
  .shade-finder-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.section_padding_bottom | times: 0.6 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
    --sf-text: {{ section.settings.text_color }};
    --sf-muted: {{ section.settings.muted_text_color }};
    --sf-accent: {{ section.settings.accent_color }};
  }
  @media screen and (min-width: 768px) {
    .shade-finder-{{ section.id }} {
      padding-top: {{ section.settings.section_padding_top }}px;
      padding-bottom: {{ section.settings.section_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="shade-finder shade-finder-{{ section.id }}"
  x-data="shadeFinder()"
  x-cloak
>
  <div class="shade-finder__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="shade-finder__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="shade-finder__controls">
      <div class="shade-finder__toggle-wrap">
        <span
          class="shade-finder__toggle-label"
          :class="{ 'is-active': view === 'swatches' }"
          @click="setView('swatches')"
        >{{ section.settings.swatches_label | escape }}</span>

        <button
          type="button"
          class="shade-finder__toggle"
          role="switch"
          :aria-checked="view === 'models' ? 'true' : 'false'"
          @click="toggleView()"
          aria-label="{{ section.settings.swatches_label | escape }} / {{ section.settings.models_label | escape }}"
        >
          <span class="shade-finder__toggle-track">
            <span class="shade-finder__toggle-thumb" :class="{ 'is-right': view === 'models' }"></span>
          </span>
        </button>

        <span
          class="shade-finder__toggle-label"
          :class="{ 'is-active': view === 'models' }"
          @click="setView('models')"
        >{{ section.settings.models_label | escape }}</span>
      </div>

      <div class="shade-finder__filters">
        <div class="shade-finder__filter-group shade-finder__filter-group--usage" role="group" aria-label="{{ section.settings.usage_label | escape }}">
          <span class="shade-finder__filter-label">{{ section.settings.usage_label | escape }}</span>
          <div class="shade-finder__pills">
            {%- assign usage_options = 'all,bronzer,blush,highlighter,color_correct' | split: ',' -%}
            {%- for opt in usage_options -%}
              <button
                type="button"
                class="shade-finder__pill"
                :class="{ 'is-active': usage === '{{ opt }}' }"
                :aria-pressed="usage === '{{ opt }}' ? 'true' : 'false'"
                @click="setUsage('{{ opt }}')"
              >
                {%- case opt -%}
                  {%- when 'all' -%}ALL
                  {%- when 'bronzer' -%}BRONZER
                  {%- when 'blush' -%}BLUSH
                  {%- when 'highlighter' -%}HIGHLIGHTER
                  {%- when 'color_correct' -%}COLOR CORRECT
                {%- endcase -%}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="shade-finder__filter-group shade-finder__filter-group--tone" role="group" aria-label="{{ section.settings.skin_tone_label | escape }}">
          <span class="shade-finder__filter-label">{{ section.settings.skin_tone_label | escape }}</span>
          <div class="shade-finder__pills">
            {%- assign tone_options = 'all,light,medium,dark' | split: ',' -%}
            {%- for opt in tone_options -%}
              <button
                type="button"
                class="shade-finder__pill"
                :class="{ 'is-active': tone === '{{ opt }}' }"
                :aria-pressed="tone === '{{ opt }}' ? 'true' : 'false'"
                @click="setTone('{{ opt }}')"
              >
                {%- case opt -%}
                  {%- when 'all' -%}ALL
                  {%- when 'light' -%}LIGHT
                  {%- when 'medium' -%}MEDIUM
                  {%- when 'dark' -%}DARK
                {%- endcase -%}
              </button>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <div
      class="shade-finder__carousel"
      :class="{ 'is-centered': visibleCount > 0 && visibleCount <= 3, 'is-empty': visibleCount === 0 }"
    >
      <button
        type="button"
        class="shade-finder__chevron shade-finder__chevron--prev"
        :class="{ 'is-hidden': visibleCount <= 3 }"
        @click="prev()"
        :disabled="!canPrev"
        aria-label="Previous shades"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="shade-finder__viewport" x-ref="viewport">
        <div
          class="shade-finder__track"
          x-ref="track"
          :style="`transform: translateX(${offset}px); transition: transform 350ms ease;`"
        >
          {%- if shades_count > 0 -%}
            {%- for shade in shades -%}
              {%- liquid
                assign usage_list = shade.usage_tags.value
                assign tone_val = shade.skin_tone.value | default: ''
                assign tone_val = tone_val | downcase
                assign usage_str = ''
                if usage_list
                  assign usage_str = usage_list | join: ','
                  assign usage_str = usage_str | downcase
                endif
                assign shade_name = shade.name.value | default: ''
                assign shade_desc = shade.description.value | default: ''
              -%}
              <article
                class="shade-finder__card"
                data-shade-card
                data-usage="{{ usage_str }}"
                data-tone="{{ tone_val }}"
                x-show="cardVisible({{ forloop.index0 }})"
                x-transition.opacity.duration.200ms
              >
                <div class="shade-finder__media">
                  {%- if shade.swatch_image.value != blank -%}
                    <img
                      class="shade-finder__image shade-finder__image--swatch"
                      src="{{ shade.swatch_image.value | image_url: width: 800 }}"
                      srcset="{{ shade.swatch_image.value | image_url: width: 400 }} 400w, {{ shade.swatch_image.value | image_url: width: 600 }} 600w, {{ shade.swatch_image.value | image_url: width: 800 }} 800w"
                      sizes="(min-width: 768px) 25vw, 85vw"
                      alt="{{ shade_name | escape }} swatch"
                      loading="lazy"
                      width="800"
                      height="800"
                      :style="`opacity: ${view === 'swatches' ? 1 : 0};`"
                    >
                  {%- else -%}
                    <div
                      class="shade-finder__image shade-finder__image--swatch shade-finder__image--placeholder"
                      :style="`opacity: ${view === 'swatches' ? 1 : 0};`"
                      aria-hidden="true"
                    >
                      {{ 'image' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if shade.model_image.value != blank -%}
                    <img
                      class="shade-finder__image shade-finder__image--model"
                      src="{{ shade.model_image.value | image_url: width: 800 }}"
                      srcset="{{ shade.model_image.value | image_url: width: 400 }} 400w, {{ shade.model_image.value | image_url: width: 600 }} 600w, {{ shade.model_image.value | image_url: width: 800 }} 800w"
                      sizes="(min-width: 768px) 25vw, 85vw"
                      alt="{{ shade_name | escape }} on model"
                      loading="lazy"
                      width="800"
                      height="800"
                      :style="`opacity: ${view === 'models' ? 1 : 0};`"
                    >
                  {%- else -%}
                    <div
                      class="shade-finder__image shade-finder__image--model shade-finder__image--placeholder"
                      :style="`opacity: ${view === 'models' ? 1 : 0};`"
                      aria-hidden="true"
                    >
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <h3 class="shade-finder__card-title">{{ shade_name | escape | upcase }}</h3>
                {%- if shade_desc != blank -%}
                  <p class="shade-finder__card-desc">{{ shade_desc | newline_to_br }}</p>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <p
          class="shade-finder__empty"
          x-show="visibleCount === 0"
          x-cloak
        >{{ section.settings.empty_state_text | escape }}</p>
      </div>

      <button
        type="button"
        class="shade-finder__chevron shade-finder__chevron--next"
        :class="{ 'is-hidden': visibleCount <= 3 }"
        @click="next()"
        :disabled="!canNext"
        aria-label="Next shades"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- if section.settings.show_find_my_shade_cta -%}
      <div class="shade-finder__cta">
        {%- if section.settings.cta_label != blank -%}
          <span class="shade-finder__cta-label">{{ section.settings.cta_label | escape }}</span>
        {%- endif -%}
        <a
          class="shade-finder__cta-button"
          href="{{ section.settings.find_my_shade_url | default: '#' }}"
        >
          {{ section.settings.cta_button_text | escape }}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  function shadeFinder() {
    return {
      view: 'swatches',
      usage: 'all',
      tone: 'all',
      index: 0,
      perView: 4,
      offset: 0,
      visibleCount: 0,
      canPrev: false,
      canNext: false,
      visibleIndexes: [],
      _cards: [],
      _resizeHandler: null,

      init() {
        this.$nextTick(() => {
          this._cards = Array.from(this.$refs.track.querySelectorAll('[data-shade-card]'));
          this.computePerView();
          this.recompute();
          this._resizeHandler = () => {
            this.computePerView();
            this.recompute();
          };
          window.addEventListener('resize', this._resizeHandler);
        });
      },

      destroy() {
        if (this._resizeHandler) window.removeEventListener('resize', this._resizeHandler);
      },

      computePerView() {
        this.perView = window.matchMedia('(min-width: 768px)').matches ? 4 : 1;
      },

      setView(v) {
        this.view = v;
      },
      toggleView() {
        this.view = this.view === 'swatches' ? 'models' : 'swatches';
      },
      setUsage(v) {
        this.usage = v;
        this.index = 0;
        this.$nextTick(() => this.recompute());
      },
      setTone(v) {
        this.tone = v;
        this.index = 0;
        this.$nextTick(() => this.recompute());
      },

      cardMatches(card) {
        const usageAttr = (card.dataset.usage || '').split(',').map(s => s.trim()).filter(Boolean);
        const toneAttr = (card.dataset.tone || '').trim();
        const usageOk = this.usage === 'all' || usageAttr.includes(this.usage);
        const toneOk = this.tone === 'all' || toneAttr === this.tone;
        return usageOk && toneOk;
      },

      cardVisible(i) {
        if (!this._cards.length) return true;
        const card = this._cards[i];
        if (!card) return false;
        return this.cardMatches(card);
      },

      recompute() {
        this.visibleIndexes = this._cards
          .map((c, i) => (this.cardMatches(c) ? i : -1))
          .filter(i => i !== -1);
        this.visibleCount = this.visibleIndexes.length;

        if (this.visibleCount <= this.perView) {
          this.index = 0;
          this.offset = 0;
          this.canPrev = false;
          this.canNext = false;
          return;
        }

        const maxIndex = Math.max(0, this.visibleCount - this.perView);
        if (this.index > maxIndex) this.index = maxIndex;

        this.$nextTick(() => this.applyOffset());
      },

      applyOffset() {
        if (!this._cards.length) {
          this.offset = 0;
          return;
        }
        const visibleCards = this.visibleIndexes.map(i => this._cards[i]);
        if (!visibleCards.length) {
          this.offset = 0;
          this.canPrev = false;
          this.canNext = false;
          return;
        }
        const target = visibleCards[this.index];
        if (!target) {
          this.offset = 0;
          return;
        }
        const viewport = this.$refs.viewport;
        const trackRect = this.$refs.track.getBoundingClientRect();
        const cardRect = target.getBoundingClientRect();
        const currentOffset = this.offset;
        const cardLeftInTrack = cardRect.left - trackRect.left - currentOffset;
        this.offset = -cardLeftInTrack;

        const maxIndex = Math.max(0, this.visibleCount - this.perView);
        this.canPrev = this.index > 0;
        this.canNext = this.index < maxIndex;
      },

      prev() {
        if (this.index > 0) {
          this.index--;
          this.applyOffset();
        }
      },
      next() {
        const maxIndex = Math.max(0, this.visibleCount - this.perView);
        if (this.index < maxIndex) {
          this.index++;
          this.applyOffset();
        }
      },
    };
  }
</script>

{% stylesheet %}
  .shade-finder {
    width: 100%;
    color: var(--sf-text, #000);
    font-family: var(--font-body-family);
  }
  .shade-finder__inner {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 48px);
  }
  .shade-finder__title {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
    margin: 0 0 2rem;
    color: var(--sf-text);
    letter-spacing: 0.01em;
  }

  .shade-finder__controls {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .shade-finder__controls {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .shade-finder__toggle-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .shade-finder__toggle-label {
    font-size: 0.875rem;
    text-transform: none;
    color: var(--sf-muted);
    cursor: pointer;
    user-select: none;
    letter-spacing: 0.02em;
  }
  .shade-finder__toggle-label.is-active {
    color: var(--sf-text);
    font-weight: 600;
  }
  .shade-finder__toggle {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }
  .shade-finder__toggle-track {
    width: 44px;
    height: 24px;
    background-color: #e5e5e5;
    border: 1px solid var(--sf-text);
    border-radius: 999px;
    position: relative;
    display: inline-block;
    transition: background-color 200ms ease;
  }
  .shade-finder__toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background-color: var(--sf-text);
    border-radius: 50%;
    transition: transform 200ms ease;
  }
  .shade-finder__toggle-thumb.is-right {
    transform: translateX(20px);
  }
  .shade-finder__toggle:focus-visible .shade-finder__toggle-track {
    outline: 2px solid var(--sf-accent);
    outline-offset: 2px;
  }

  .shade-finder__filters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    width: 100%;
  }
  @media (min-width: 768px) {
    .shade-finder__filters {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 2rem;
      flex: 1;
      width: auto;
    }
  }

  .shade-finder__filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .shade-finder__filter-group {
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
    .shade-finder__filter-group--usage {
      margin-inline-end: auto;
    }
  }
  .shade-finder__filter-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sf-text);
    font-weight: 600;
    white-space: nowrap;
  }
  .shade-finder__pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .shade-finder__pill {
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--sf-text);
    background-color: #fff;
    color: var(--sf-text);
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
    min-height: 36px;
    line-height: 1;
    white-space: nowrap;
  }
  .shade-finder__pill.is-active {
    background-color: var(--sf-accent);
    color: #fff;
    border-color: var(--sf-accent);
  }
  .shade-finder__pill:focus-visible {
    outline: 2px solid var(--sf-accent);
    outline-offset: 2px;
  }

  .shade-finder__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .shade-finder__viewport {
    position: relative;
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }
  .shade-finder__track {
    display: flex;
    gap: 1rem;
    will-change: transform;
  }
  .shade-finder__carousel.is-centered .shade-finder__track {
    justify-content: center;
  }

  .shade-finder__card {
    flex: 0 0 calc((100% - 3rem) / 4);
    min-width: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (max-width: 767.98px) {
    .shade-finder__card {
      flex: 0 0 83%;
    }
    .shade-finder__track {
      gap: 0.75rem;
    }
  }

  .shade-finder__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f4f4f4;
  }
  .shade-finder__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 200ms ease;
  }
  .shade-finder__image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ececec;
  }
  .shade-finder__placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .shade-finder__card-title {
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
    color: var(--sf-text);
  }
  .shade-finder__card-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--sf-muted);
    margin: 0;
    font-weight: 400;
  }

  .shade-finder__chevron {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--sf-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 150ms ease;
  }
  .shade-finder__chevron:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .shade-finder__chevron.is-hidden {
    visibility: hidden;
    pointer-events: none;
  }
  .shade-finder__chevron:focus-visible {
    outline: 2px solid var(--sf-accent);
    outline-offset: 2px;
    border-radius: 50%;
  }
  @media (max-width: 767.98px) {
    .shade-finder__carousel {
      gap: 0;
    }
    .shade-finder__chevron {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 36px;
      height: 36px;
      background-color: rgba(255, 255, 255, 0.85);
      border-radius: 50%;
    }
    .shade-finder__chevron--prev {
      left: 4px;
      top: 38%;
    }
    .shade-finder__chevron--next {
      right: calc(17% + 4px);
      top: 38%;
    }
  }

  .shade-finder__empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--sf-muted);
    font-size: 0.95rem;
    width: 100%;
  }
  .shade-finder__carousel.is-empty .shade-finder__track {
    display: none;
  }

  .shade-finder__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }
  @media (min-width: 768px) {
    .shade-finder__cta {
      justify-content: flex-end;
    }
  }
  .shade-finder__cta-label {
    font-size: 0.9rem;
    color: var(--sf-muted);
    font-style: italic;
  }
  .shade-finder__cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background-color: var(--sf-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    transition: opacity 150ms ease;
  }
  .shade-finder__cta-button:hover,
  .shade-finder__cta-button:focus-visible {
    opacity: 0.85;
    color: #fff;
  }
  .shade-finder__cta-button:focus-visible {
    outline: 2px solid var(--sf-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shade-finder__image,
    .shade-finder__toggle-thumb,
    .shade-finder__track,
    .shade-finder__pill,
    .shade-finder__cta-button {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "What Shade Am I",
  "tag": "section",
  "class": "section-shade-finder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Shade Am I?"
    },
    {
      "type": "header",
      "content": "Find My Shade CTA"
    },
    {
      "type": "checkbox",
      "id": "show_find_my_shade_cta",
      "label": "Show Find My Shade CTA",
      "default": true
    },
    {

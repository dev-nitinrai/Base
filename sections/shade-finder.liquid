{{ 'section-shade-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shade-finder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading           = section.settings.heading
  assign default_view      = section.settings.default_view
  assign label_swatches    = section.settings.toggle_label_swatches
  assign label_models      = section.settings.toggle_label_models
  assign show_arrows       = section.settings.show_arrows
  assign cta_pre_text      = section.settings.cta_pre_text
  assign cta_text          = section.settings.cta_text
  assign cta_url           = section.settings.cta_url
  assign bg_color          = section.settings.bg_color
  assign heading_color     = section.settings.heading_color
  assign text_color        = section.settings.text_color
  assign pill_active_bg    = section.settings.pill_active_bg
  assign pill_active_text  = section.settings.pill_active_text
  assign button_bg         = section.settings.button_bg
  assign button_text_color = section.settings.button_text_color
  assign padding_top       = section.settings.padding_top
  assign padding_bottom    = section.settings.padding_bottom
  assign card_gap          = section.settings.card_gap

  assign shades_source = section.settings.shades
  assign has_metaobjects = false
  if shades_source != blank
    assign has_metaobjects = true
  endif
-%}

<style>
  #shade-finder-{{ section.id }} {
    --sf-bg:               {{ bg_color }};
    --sf-heading-color:    {{ heading_color }};
    --sf-text-color:       {{ text_color }};
    --sf-pill-active-bg:   {{ pill_active_bg }};
    --sf-pill-active-text: {{ pill_active_text }};
    --sf-btn-bg:           {{ button_bg }};
    --sf-btn-text:         {{ button_text_color }};
    --sf-card-gap:         {{ card_gap }}px;
    --sf-padding-top:      {{ padding_top | times: 0.75 | round: 0 }}px;
    --sf-padding-bottom:   {{ padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #shade-finder-{{ section.id }} {
      --sf-padding-top:    {{ padding_top }}px;
      --sf-padding-bottom: {{ padding_bottom }}px;
    }
  }
</style>

{%- comment -%}
  The root element MUST be <shade-finder> so the custom element JS class
  (registered via customElements.define('shade-finder', ShadeFinder)) fires
  connectedCallback and wires up all interactivity.
{%- endcomment -%}
<shade-finder
  id="shade-finder-{{ section.id }}"
  class="shade-finder"
  data-section-id="{{ section.id }}"
  data-default-view="{{ default_view }}"
  data-view="{{ default_view }}"
>
  <div class="page-width">

    {%- comment -%} Screen-reader live region for filter announcements {%- endcomment -%}
    <span class="shade-finder__sr-announce visually-hidden" aria-live="polite" aria-atomic="true"></span>

    {%- comment -%} ── Heading ── {%- endcomment -%}
    {%- if heading != blank -%}
      <div class="shade-finder__header">
        <h2 class="shade-finder__heading">{{ heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- comment -%} ── Controls: toggle + filter pills ── {%- endcomment -%}
    <div class="shade-finder__controls">

      {%- comment -%} Swatches / Models toggle — top-left {%- endcomment -%}
      <div class="shade-finder__toggle" role="group" aria-label="Image view">
        <span
          class="shade-finder__toggle-label"
          data-view="swatches"
          aria-hidden="true"
        >{{ label_swatches | escape }}</span>

        <button
          class="shade-finder__toggle-track"
          role="switch"
          aria-checked="{{ default_view | downcase | replace: 'models', 'true' | replace: 'swatches', 'false' }}"
          aria-label="Toggle between {{ label_swatches | escape }} and {{ label_models | escape }}"
        >
          <span class="shade-finder__toggle-thumb"></span>
        </button>

        <span
          class="shade-finder__toggle-label"
          data-view="models"
          aria-hidden="true"
        >{{ label_models | escape }}</span>
      </div>

      {%- comment -%} Filter groups — right side, two groups side by side {%- endcomment -%}
      <div class="shade-finder__filters" role="group" aria-label="Filter shades">

        {%- comment -%} USAGE filter {%- endcomment -%}
        <div class="shade-finder__filter-group" role="group" aria-labelledby="sf-usage-label-{{ section.id }}">
          <span id="sf-usage-label-{{ section.id }}" class="shade-finder__filter-label">USAGE</span>
          <div class="shade-finder__pill-row">
            <button class="shade-finder__pill shade-finder__pill--active" data-group="usage" data-value="all" aria-pressed="true">ALL</button>
            <button class="shade-finder__pill" data-group="usage" data-value="bronzer" aria-pressed="false">BRONZER</button>
            <button class="shade-finder__pill" data-group="usage" data-value="blush" aria-pressed="false">BLUSH</button>
            <button class="shade-finder__pill" data-group="usage" data-value="highlighter" aria-pressed="false">HIGHLIGHTER</button>
            <button class="shade-finder__pill" data-group="usage" data-value="color_correct" aria-pressed="false">COLOR CORRECT</button>
          </div>
        </div>

        {%- comment -%} SKIN TONE filter {%- endcomment -%}
        <div class="shade-finder__filter-group" role="group" aria-labelledby="sf-tone-label-{{ section.id }}">
          <span id="sf-tone-label-{{ section.id }}" class="shade-finder__filter-label">SKIN TONE</span>
          <div class="shade-finder__pill-row">
            <button class="shade-finder__pill shade-finder__pill--active" data-group="tone" data-value="all" aria-pressed="true">ALL</button>
            <button class="shade-finder__pill" data-group="tone" data-value="light" aria-pressed="false">LIGHT</button>
            <button class="shade-finder__pill" data-group="tone" data-value="medium" aria-pressed="false">MEDIUM</button>
            <button class="shade-finder__pill" data-group="tone" data-value="dark" aria-pressed="false">DARK</button>
          </div>
        </div>

      </div>
    </div>

    {%- comment -%} ── Grid with optional arrow nav ── {%- endcomment -%}
    <div class="shade-finder__grid-wrapper">

      {%- if show_arrows -%}
        <button
          class="shade-finder__arrow shade-finder__arrow--prev"
          aria-label="Previous shades"
          aria-disabled="true"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="shade-finder__grid" role="list" aria-label="Shade cards">

        {%- if has_metaobjects -%}

          {%- for shade in shades_source -%}
            {%- liquid
              assign shade_name  = shade.name.value
              assign shade_desc  = shade.description.value
              assign shade_usage = shade.usage.value | downcase | strip
              assign shade_tones = ''
              if shade.skin_tone != blank
                assign shade_tones = shade.skin_tone.value | downcase | strip
              endif
              assign model_img   = shade.model_image.value
              assign swatch_img  = shade.swatch_image.value
            -%}

            <article
              class="shade-finder__card"
              role="listitem"
              data-usage="{{ shade_usage }}"
              data-tone="{{ shade_tones }}"
              aria-label="{{ shade_name | escape }}"
            >
              <div class="shade-finder__card-image-wrap">
                {%- if model_img != blank -%}
                  <img
                    class="shade-finder__card-img shade-finder__card-img--model"
                    src="{{ model_img | image_url: width: 600 }}"
                    srcset="{{ model_img | image_url: width: 400 }} 400w, {{ model_img | image_url: width: 600 }} 600w, {{ model_img | image_url: width: 800 }} 800w"
                    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                    alt="{{ model_img.alt | default: shade_name | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {%- else -%}
                  <div class="shade-finder__card-img shade-finder__card-img--model shade-finder__card-placeholder" aria-hidden="true">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
                  </div>
                {%- endif -%}

                {%- if swatch_img != blank -%}
                  <img
                    class="shade-finder__card-img shade-finder__card-img--swatch"
                    src="{{ swatch_img | image_url: width: 600 }}"
                    srcset="{{ swatch_img | image_url: width: 400 }} 400w, {{ swatch_img | image_url: width: 600 }} 600w, {{ swatch_img | image_url: width: 800 }} 800w"
                    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                    alt="{{ swatch_img.alt | default: shade_name | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {%- else -%}
                  <div class="shade-finder__card-img shade-finder__card-img--swatch shade-finder__card-placeholder" aria-hidden="true">
                    {{ 'product-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              <h3 class="shade-finder__card-name">{{ shade_name | escape }}</h3>
              {%- if shade_desc != blank -%}
                <p class="shade-finder__card-desc">{{ shade_desc | escape }}</p>
              {%- endif -%}
            </article>

          {%- endfor -%}

        {%- else -%}

          {%- comment -%}
            Fallback: 4 hardcoded sample shades matching the reference mockup.
            These render when no metaobject list is configured in section settings.
          {%- endcomment -%}

          <article
            class="shade-finder__card"
            role="listitem"
            data-usage="highlighter"
            data-tone="all"
            aria-label="Au Naturel"
          >
            <div class="shade-finder__card-image-wrap">
              <div class="shade-finder__card-img shade-finder__card-img--model shade-finder__card-placeholder" aria-hidden="true">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
              <div class="shade-finder__card-img shade-finder__card-img--swatch shade-finder__card-placeholder" aria-hidden="true">
                {{ 'product-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
            </div>
            <h3 class="shade-finder__card-name">AU NATUREL</h3>
            <p class="shade-finder__card-desc">is a clear balm with subtle opal pearl for all skin tones</p>
          </article>

          <article
            class="shade-finder__card"
            role="listitem"
            data-usage="blush"
            data-tone="light,medium"
            aria-label="Happy Hour"
          >
            <div class="shade-finder__card-image-wrap">
              <div class="shade-finder__card-img shade-finder__card-img--model shade-finder__card-placeholder" aria-hidden="true">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
              <div class="shade-finder__card-img shade-finder__card-img--swatch shade-finder__card-placeholder" aria-hidden="true">
                {{ 'product-2' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
            </div>
            <h3 class="shade-finder__card-name">HAPPY HOUR</h3>
            <p class="shade-finder__card-desc">a cool sheer pink with silver shimmer for fair to medium tan skin tones</p>
          </article>

          <article
            class="shade-finder__card"
            role="listitem"
            data-usage="bronzer"
            data-tone="light,medium,dark"
            aria-label="Magic Hour"
          >
            <div class="shade-finder__card-image-wrap">
              <div class="shade-finder__card-img shade-finder__card-img--model shade-finder__card-placeholder" aria-hidden="true">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
              <div class="shade-finder__card-img shade-finder__card-img--swatch shade-finder__card-placeholder" aria-hidden="true">
                {{ 'product-3' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
            </div>
            <h3 class="shade-finder__card-name">MAGIC HOUR</h3>
            <p class="shade-finder__card-desc">is a cool, sheer bronze with silver shimmer for light to medium-dark skin</p>
          </article>

          <article
            class="shade-finder__card"
            role="listitem"
            data-usage="highlighter"
            data-tone="all"
            aria-label="Golden Hour"
          >
            <div class="shade-finder__card-image-wrap">
              <div class="shade-finder__card-img shade-finder__card-img--model shade-finder__card-placeholder" aria-hidden="true">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
              <div class="shade-finder__card-img shade-finder__card-img--swatch shade-finder__card-placeholder" aria-hidden="true">
                {{ 'product-4' | placeholder_svg_tag: 'shade-finder__placeholder-svg' }}
              </div>
            </div>
            <h3 class="shade-finder__card-name">GOLDEN HOUR</h3>
            <p class="shade-finder__card-desc">is a warm, sheer gold with multidimensional shimmer for all skin tones</p>
          </article>

        {%- endif -%}

        <p class="shade-finder__empty" hidden>No shades match the selected filters.</p>

      </div>

      {%- if show_arrows -%}
        <button
          class="shade-finder__arrow shade-finder__arrow--next"
          aria-label="Next shades"
          aria-disabled="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

    </div>

    {%- comment -%} ── CTA row ── {%- endcomment -%}
    {%- if cta_text != blank or cta_pre_text != blank -%}
      <div class="shade-finder__cta-row">
        {%- if cta_pre_text != blank -%}
          <span class="shade-finder__cta-pre">{{ cta_pre_text | escape }}</span>
        {%- endif -%}
        {%- if cta_text != blank -%}
          {%- if cta_url != blank -%}
            <a href="{{ cta_url }}" class="shade-finder__cta-btn">
              {{ cta_text | escape }}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          {%- else -%}
            <button class="shade-finder__cta-btn" type="button">
              {{ cta_text | escape }}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</shade-finder>

{% schema %}
{
  "name": "Shade Finder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Shade Am I?"
    },
    {
      "type": "metaobject_list",
      "id": "shades",
      "label": "Shade Metaobjects",
      "metaobject_type": "shade"
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Default View",
      "options": [
        { "value": "models", "label": "Models" },
        { "value": "swatches", "label": "Swatches" }
      ],
      "default": "models"
    },
    {
      "type": "text",
      "id": "toggle_label_swatches",
      "label": "Toggle Label — Swatches",
      "default": "Swatches"
    },
    {
      "type": "text",
      "id": "toggle_label_models",
      "label": "Toggle Label — Models",
      "default": "Models"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrow Navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_pre_text",
      "label": "CTA Pre-text",
      "default": "Still Not Sure?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "FIND MY SHADE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "pill_active_bg",
      "label": "Active Filter Pill Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "pill_active_text",
      "label": "Active Filter Pill Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "CTA Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "CTA Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Shade Finder",
      "settings": {
        "heading": "What Shade Am I?",
        "default_view": "models",
        "toggle_label_swatches": "Swatches",
        "toggle_label_models": "Models",
        "show_arrows": true,
        "cta_pre_text": "Still Not Sure?",
        "cta_text": "FIND MY SHADE",
        "bg_color": "#F5F5F5",
        "heading_color": "#1A1A1A",
        "text_color": "#1A1A1A",
        "pill_active_bg": "#000000",
        "pill_active_text": "#FFFFFF",
        "button_bg": "#000000",
        "button_text_color": "#FFFFFF",
        "padding_top": 80,
        "padding_bottom": 80,
        "card_gap": 24
      }
    }
  ]
}
{% endschema %}

          "label": "Usage category",
          "default": "Blush",
          "info": "Must match one of the usage filter options exactly. E.g. Bronzer, Blush, Highlighter, Color Correct"
        },
        {
          "type": "text",
          "id": "skin_tone",
          "label": "Skin tone category",
          "default": "Light",
          "info": "Must match one of the skin tone filter options exactly. E.g. Light, Medium, Dark"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shade Finder",
      "settings": {
        "heading": "What Shade Am I?",
        "toggle_label_left": "Swatches",
        "toggle_label_right": "Models",
        "usage_label": "USAGE",
        "usage_filters": "Bronzer, Blush, Highlighter, Color Correct",
        "skin_tone_label": "SKIN TONE",

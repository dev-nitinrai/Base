{{ 'section-shade-finder.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .shade-finder-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 767px) {
    .shade-finder-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<section class="shade-finder shade-finder-{{ section.id }}" id="shade-finder-{{ section.id }}">
  <div class="shade-finder__inner">

    <div class="shade-finder__top-bar">
      <div class="shade-finder__toggle-wrap">
        <span>{{ section.settings.toggle_label_left }}</span>
        <label class="shade-finder__toggle" aria-label="{{ section.settings.toggle_label_left }} / {{ section.settings.toggle_label_right }} toggle">
          <input type="checkbox" id="shade-toggle-{{ section.id }}" class="shade-finder__toggle-input">
          <span class="shade-finder__toggle-slider"></span>
        </label>
        <span>{{ section.settings.toggle_label_right }}</span>
      </div>

      <h2 class="shade-finder__heading">{{ section.settings.heading }}</h2>

      <div class="shade-finder__top-bar-spacer" aria-hidden="true"></div>
    </div>

    <div class="shade-finder__filters" role="group" aria-label="Filter shades">
      <div class="shade-finder__filter-group">
        <span class="shade-finder__filter-label">{{ section.settings.usage_label }}</span>
        <div class="shade-finder__filter-group-buttons" role="group" aria-label="{{ section.settings.usage_label }} filter">
          {%- assign usage_filters = section.settings.usage_filters | split: ',' -%}
          <button
            type="button"
            class="shade-finder__filter-btn is-active"
            data-filter-type="usage"
            data-filter-value="all"
            aria-pressed="true"
          >{{ section.settings.filter_all_label }}</button>
          {%- for filter in usage_filters -%}
            {%- assign filter_trimmed = filter | strip -%}
            <button
              type="button"
              class="shade-finder__filter-btn"
              data-filter-type="usage"
              data-filter-value="{{ filter_trimmed | handleize }}"
              aria-pressed="false"
            >{{ filter_trimmed }}</button>
          {%- endfor -%}
        </div>
      </div>

      <div class="shade-finder__filter-group">
        <span class="shade-finder__filter-label">{{ section.settings.skin_tone_label }}</span>
        <div class="shade-finder__filter-group-buttons" role="group" aria-label="{{ section.settings.skin_tone_label }} filter">
          {%- assign tone_filters = section.settings.skin_tone_filters | split: ',' -%}
          <button
            type="button"
            class="shade-finder__filter-btn is-active"
            data-filter-type="tone"
            data-filter-value="all"
            aria-pressed="true"
          >{{ section.settings.filter_all_label }}</button>
          {%- for tone in tone_filters -%}
            {%- assign tone_trimmed = tone | strip -%}
            <button
              type="button"
              class="shade-finder__filter-btn"
              data-filter-type="tone"
              data-filter-value="{{ tone_trimmed | handleize }}"
              aria-pressed="false"
            >{{ tone_trimmed }}</button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="shade-finder__carousel-wrap">
      <button
        type="button"
        class="shade-finder__nav shade-finder__nav--prev"
        aria-label="{{ 'general.accessibility.previous' | t | default: 'Previous shades' }}"
        disabled
      >
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M13 16L7 10L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="shade-finder__carousel" aria-live="polite" aria-label="Shade results">
        <div class="shade-finder__track" id="shade-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'shade' -%}
              <article
                class="shade-finder__slide"
                data-usage="{{ block.settings.usage | handleize }}"
                data-tone="{{ block.settings.skin_tone | handleize }}"
                {{ block.shopify_attributes }}
              >
                <div class="shade-finder__image-wrap">
                  {%- if block.settings.model_image != blank -%}
                    <img
                      class="shade-finder__img shade-finder__img--model"
                      src="{{ block.settings.model_image | image_url: width: 600 }}"
                      srcset="{{ block.settings.model_image | image_url: width: 400 }} 400w, {{ block.settings.model_image | image_url: width: 600 }} 600w, {{ block.settings.model_image | image_url: width: 800 }} 800w"
                      sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 85vw"
                      alt="{{ block.settings.model_image.alt | default: block.settings.shade_name | escape }}"
                      loading="lazy"
                      width="{{ block.settings.model_image.width }}"
                      height="{{ block.settings.model_image.height }}"
                      data-image-type="model"
                    >
                  {%- else -%}
                    <div class="shade-finder__img-placeholder" data-image-type="model">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.swatch_image != blank -%}
                    <img
                      class="shade-finder__img shade-finder__img--swatch"
                      src="{{ block.settings.swatch_image | image_url: width: 600 }}"
                      srcset="{{ block.settings.swatch_image | image_url: width: 400 }} 400w, {{ block.settings.swatch_image | image_url: width: 600 }} 600w, {{ block.settings.swatch_image | image_url: width: 800 }} 800w"
                      sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 85vw"
                      alt="{{ block.settings.swatch_image.alt | default: block.settings.shade_name | escape }} swatch"
                      loading="lazy"
                      width="{{ block.settings.swatch_image.width }}"
                      height="{{ block.settings.swatch_image.height }}"
                      data-image-type="swatch"
                      style="opacity: 0;"
                    >
                  {%- else -%}
                    <div class="shade-finder__img-placeholder shade-finder__img-placeholder--swatch" data-image-type="swatch" style="opacity: 0; position: absolute; inset: 0;">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <div class="shade-finder__card-body">
                  <h3 class="shade-finder__shade-name">{{ block.settings.shade_name }}</h3>
                  <p class="shade-finder__shade-desc">{{ block.settings.shade_description }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <button
        type="button"
        class="shade-finder__nav shade-finder__nav--next"
        aria-label="{{ 'general.accessibility.next' | t | default: 'Next shades' }}"
      >
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <p class="shade-finder__empty" id="shade-empty-{{ section.id }}" role="status">
      No shades match the selected filters.
    </p>

    <div class="shade-finder__footer">
      <span class="shade-finder__cta-label">{{ section.settings.cta_label }}</span>
      <a
        href="{{ section.settings.cta_url | default: '#' }}"
        class="shade-finder__cta-btn"
      >
        <span class="shade-finder__cta-btn-text">{{ section.settings.cta_button_text }}</span>
        <span class="shade-finder__cta-btn-arrow" aria-hidden="true">&#8250;</span>
      </a>
    </div>

  </div>
</section>

<script>
(function () {
  'use strict';

  var sectionId = '{{ section.id }}';
  var root = document.getElementById('shade-finder-' + sectionId);
  if (!root) return;

  var track = root.querySelector('.shade-finder__track');
  if (!track) return;

  var prevBtn = root.querySelector('.shade-finder__nav--prev');
  var nextBtn = root.querySelector('.shade-finder__nav--next');
  var toggleInput = root.querySelector('.shade-finder__toggle-input');
  var emptyMsg = document.getElementById('shade-empty-' + sectionId);
  var allSlides = Array.prototype.slice.call(track.querySelectorAll('.shade-finder__slide'));

  var activeUsage = 'all';
  var activeTone = 'all';
  var offset = 0;
  var visibleSlides = [];

  function getSlidesPerView() {
    var w = window.innerWidth;
    if (w >= 1024) return 4;
    if (w >= 768) return 2;
    return 1;
  }

  function getVisibleSlides() {
    return allSlides.filter(function (slide) {
      var usage = slide.dataset.usage;
      var tone = slide.dataset.tone;
      var usageMatch = activeUsage === 'all' || usage === activeUsage;
      var toneMatch = activeTone === 'all' || tone === activeTone;
      return usageMatch && toneMatch;
    });
  }

  function updateCarousel() {
    var perView = getSlidesPerView();
    var maxOffset = Math.max(0, visibleSlides.length - perView);
    offset = Math.min(offset, maxOffset);

    if (visibleSlides.length === 0) {
      track.style.transform = 'translateX(0)';
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = true;
      return;
    }

    var slideWidth = visibleSlides[0].getBoundingClientRect().width;
    var gap = 20;
    var translateX = offset * (slideWidth + gap);
    track.style.transform = 'translateX(-' + translateX + 'px)';

    if (prevBtn) prevBtn.disabled = offset <= 0;
    if (nextBtn) nextBtn.disabled = offset >= maxOffset;
  }

  function applyFilters() {
    offset = 0;
    visibleSlides = getVisibleSlides();

    allSlides.forEach(function (slide) {
      slide.style.display = 'none';
    });

    visibleSlides.forEach(function (slide) {
      slide.style.display = '';
    });

    if (emptyMsg) {
      if (visibleSlides.length === 0) {
        emptyMsg.classList.add('is-visible');
      } else {
        emptyMsg.classList.remove('is-visible');
      }
    }

    updateCarousel();
  }

  function handleFilterClick(btn) {
    var type = btn.dataset.filterType;
    var value = btn.dataset.filterValue;

    var group = btn.closest('.shade-finder__filter-group-buttons');
    var siblings = group.querySelectorAll('.shade-finder__filter-btn');
    siblings.forEach(function (b) {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');

    if (type === 'usage') activeUsage = value;
    if (type === 'tone') activeTone = value;

    applyFilters();
  }

  function handleToggle() {
    var showModels = !toggleInput.checked;
    allSlides.forEach(function (slide) {
      var modelImgs = slide.querySelectorAll('[data-image-type="model"]');
      var swatchImgs = slide.querySelectorAll('[data-image-type="swatch"]');
      modelImgs.forEach(function (img) {
        img.style.opacity = showModels ? '1' : '0';
      });
      swatchImgs.forEach(function (img) {
        img.style.opacity = showModels ? '0' : '1';
      });
    });
  }

  var filterBtns = root.querySelectorAll('.shade-finder__filter-btn');
  filterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { handleFilterClick(btn); });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      offset = Math.max(0, offset - 1);
      updateCarousel();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      var perView = getSlidesPerView();
      var maxOffset = Math.max(0, visibleSlides.length - perView);
      offset = Math.min(maxOffset, offset + 1);
      updateCarousel();
    });
  }

  if (toggleInput) {
    toggleInput.addEventListener('change', handleToggle);
  }

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      updateCarousel();
    }, 100);
  });

  applyFilters();
}());
</script>

{% schema %}
{
  "name": "Shade Finder",
  "tag": "section",
  "class": "section-shade-finder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Shade Am I?"
    },
    {
      "type": "text",
      "id": "toggle_label_left",
      "label": "Toggle label — left (swatches)",
      "default": "Swatches"
    },
    {
      "type": "text",
      "id": "toggle_label_right",
      "label": "Toggle label — right (models)",
      "default": "Models"
    },
    {
      "type": "text",
      "id": "usage_label",
      "label": "Usage filter label",
      "default": "USAGE"
    },
    {
      "type": "text",
      "id": "usage_filters",
      "label": "Usage filter options (comma-separated)",
      "default": "Bronzer, Blush, Highlighter, Color Correct",
      "info": "Separate each option with a comma. These must match the Usage value set on each shade block."
    },
    {
      "type": "text",
      "id": "skin_tone_label",
      "label": "Skin tone filter label",
      "default": "SKIN TONE"
    },
    {
      "type": "text",
      "id": "skin_tone_filters",
      "label": "Skin tone filter options (comma-separated)",
      "default": "Light, Medium, Dark",
      "info": "Separate each option with a comma. These must match the Skin tone value set on each shade block."
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "All filter button label",
      "default": "ALL"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA prefix text",
      "default": "Still Not Sure?"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA button text",
      "default": "FIND MY SHADE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "shade",
      "name": "Shade",
      "settings": [
        {
          "type": "text",
          "id": "shade_name",
          "label": "Shade name",
          "default": "Shade Name"
        },
        {
          "type": "textarea",
          "id": "shade_description",
          "label": "Shade description",
          "default": "A description of this shade and who it suits."
        },
        {
          "type": "image_picker",
          "id": "model_image",
          "label": "Model image"
        },
        {
          "type": "image_picker",
          "id": "swatch_image",
          "label": "Swatch image"
        },
        {
          "type": "text",

{% comment %} /sections/Faq-metaobjects.liquid {% endcomment %}
{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign faq_items = section.settings.faq_items -%}

<div class="color-{{ section.settings.color_scheme }} faq-section section-{{ section.id }}-padding">
  <div class="page-width">

    {%- if section.settings.title != blank -%}
      <h2 class="faq__heading">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if faq_items != blank -%}

      {%- comment -%}
        Render accordion items sourced from the faq_item metaobject.
        Fields accessed via dot notation on the metaobject drop:
          item.question → single_line_text_field value (string)
          item.answer   → multi_line_text_field value (string, newlines preserved)
      {%- endcomment -%}

      <div
        class="faq__container"
        x-data="{ openBlock: null }"
      >
        {%- for item in faq_items -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign question_text = item.question -%}
          {%- assign answer_text = item.answer -%}

          {%- if question_text != blank -%}
            <div class="faq__block">
              <div class="faq__accordion">

                <button
                  @click="openBlock = openBlock === {{ idx }} ? null : {{ idx }}"
                  class="faq__header"
                  :aria-expanded="openBlock === {{ idx }}"
                  type="button"
                >
                  <h3 class="faq__title">{{ question_text | escape }}</h3>

                  <span class="faq__icon" x-show="openBlock !== {{ idx }}">
                    {{ 'icon-plus.svg' | inline_asset_content }}
                  </span>
                  <span class="faq__icon" x-show="openBlock === {{ idx }}" x-cloak>
                    {{ 'icon-minus.svg' | inline_asset_content }}
                  </span>
                </button>

                <div
                  x-show="openBlock === {{ idx }}"
                  x-transition
                  class="faq__content"
                  x-cloak
                >
                  <div class="faq__content-wrapper">
                    <div class="faq__answer">
                      {%- if answer_text != blank -%}
                        {{ answer_text | newline_to_br }}
                      {%- else -%}
                        <p>No answer provided for this FAQ item.</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- elsif request.design_mode -%}

      {%- comment -%}
        Empty state — only visible inside the theme editor.
        Guides the merchant through the one-time setup steps.
      {%- endcomment -%}

      <div class="faq__setup-notice">
        <div class="faq__setup-notice-inner">
          <p class="faq__setup-notice-title">No FAQ items selected</p>
          <p>To populate this section:</p>
          <ol class="faq__setup-steps">
            <li>
              In your Shopify Admin go to
              <strong>Content &rarr; Metaobjects</strong> and create a definition
              of type <code>faq_item</code> with two fields:
              <code>question</code> (Single line text) and
              <code>answer</code> (Multi-line text).
            </li>
            <li>Add FAQ entries (e.g. Shipping, Returns, Sizing) under that definition.</li>
            <li>
              Return here and pick your entries from the
              <strong>&ldquo;FAQ Items&rdquo;</strong> setting in the sidebar.
            </li>
          </ol>
          <p class="faq__setup-notice-hint">
            For a ready-to-run setup script see
            <code>assets/faq-metaobjects-setup.graphql</code> in your theme files.
          </p>
        </div>
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "FAQ — Metaobjects",
  "tag": "section",
  "class": "faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "metaobject_list",
      "id": "faq_items",
      "label": "FAQ Items",
      "metaobject_type": "faq_item",
      "limit": 30,
      "info": "Select entries from the faq_item metaobject. Create the definition and entries in Content › Metaobjects first."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "FAQ — Metaobjects"
    }
  ]
}
{% endschema %}

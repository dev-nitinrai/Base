{{ 'section-what-shade-am-i.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shades = shop.metaobjects.agent_shade.values
  assign shade_count = shades | size
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shade-finder-{{ section.id }} {
    --shade-bg: {{ section.settings.bg_color }};
    --shade-text: {{ section.settings.text_color }};
    --shade-accent: {{ section.settings.accent_color }};
    --shade-accent-text: {{ section.settings.accent_text_color }};
    background-color: var(--shade-bg);
    color: var(--shade-text);
  }
{%- endstyle -%}

<section
  class="shade-finder shade-finder-{{ section.id }} section-{{ section.id }}-padding"
  x-data="shadeFinder({
    view: 'swatches',
    usage: 'all',
    skinTone: 'all',
    slide: 0
  })"
>
  <div class="page-width shade-finder__inner">
    <h2 class="shade-finder__heading">{{ section.settings.heading | escape }}</h2>

    <div class="shade-finder__topbar">
      <div class="shade-finder__toggle-wrap">
        <button
          type="button"
          role="switch"
          class="shade-finder__toggle"
          :aria-checked="view === 'models'"
          @click="setView(view === 'swatches' ? 'models' : 'swatches')"
        >
          <span
            class="shade-finder__toggle-label"
            :class="{ 'is-active': view === 'swatches' }"
          >{{ section.settings.swatches_label | escape }}</span>
          <span class="shade-finder__toggle-track" aria-hidden="true">
            <span class="shade-finder__toggle-thumb" :class="{ 'is-right': view === 'models' }"></span>
          </span>
          <span
            class="shade-finder__toggle-label"
            :class="{ 'is-active': view === 'models' }"
          >{{ section.settings.models_label | escape }}</span>
        </button>
      </div>

      <div class="shade-finder__filters">
        <div class="shade-finder__filter-group shade-finder__filter-group--usage">
          <span class="shade-finder__filter-legend">{{ section.settings.usage_label | escape }}</span>
          <div class="shade-finder__pills" role="group" aria-label="{{ section.settings.usage_label | escape }}">
            {%- assign usage_options = 'all,bronzer,blush,highlighter,color_correct' | split: ',' -%}
            {%- for opt in usage_options -%}
              {%- case opt -%}
                {%- when 'all' -%}{%- assign label = 'ALL' -%}
                {%- when 'bronzer' -%}{%- assign label = 'BRONZER' -%}
                {%- when 'blush' -%}{%- assign label = 'BLUSH' -%}
                {%- when 'highlighter' -%}{%- assign label = 'HIGHLIGHTER' -%}
                {%- when 'color_correct' -%}{%- assign label = 'COLOR CORRECT' -%}
              {%- endcase -%}
              <button
                type="button"
                class="shade-finder__pill"
                :class="{ 'is-active': usage === '{{ opt }}' }"
                :aria-pressed="usage === '{{ opt }}'"
                @click="setUsage('{{ opt }}')"
              >{{ label }}</button>
            {%- endfor -%}
          </div>
        </div>

        <div class="shade-finder__filter-group shade-finder__filter-group--tone">
          <span class="shade-finder__filter-legend">{{ section.settings.skin_tone_label | escape }}</span>
          <div class="shade-finder__pills" role="group" aria-label="{{ section.settings.skin_tone_label | escape }}">
            {%- assign tone_options = 'all,light,medium,dark' | split: ',' -%}
            {%- for opt in tone_options -%}
              {%- case opt -%}
                {%- when 'all' -%}{%- assign label = 'ALL' -%}
                {%- when 'light' -%}{%- assign label = 'LIGHT' -%}
                {%- when 'medium' -%}{%- assign label = 'MEDIUM' -%}
                {%- when 'dark' -%}{%- assign label = 'DARK' -%}
              {%- endcase -%}
              <button
                type="button"
                class="shade-finder__pill"
                :class="{ 'is-active': skinTone === '{{ opt }}' }"
                :aria-pressed="skinTone === '{{ opt }}'"
                @click="setSkinTone('{{ opt }}')"
              >{{ label }}</button>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    {%- if shade_count > 0 -%}
      <div
        class="shade-finder__carousel"
        :class="{ 'is-centered': visibleCount > 0 && visibleCount <= 3, 'is-empty': visibleCount === 0 }"
      >
        <button
          type="button"
          class="shade-finder__nav shade-finder__nav--prev"
          aria-label="Previous shades"
          @click="prev()"
          x-show="showNav"
          :disabled="slide === 0"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="shade-finder__viewport" x-ref="viewport">
          <div
            class="shade-finder__track"
            x-ref="track"
            :style="trackStyle"
          >
            {%- for shade in shades -%}
              {%- assign usage_list = shade.usage_tags.value -%}
              {%- assign tone_value = shade.skin_tone.value -%}
              {%- capture usage_data -%}
                {%- if usage_list -%}
                  {%- for tag in usage_list -%}{{ tag | downcase | strip }}{%- unless forloop.last %},{% endunless -%}{%- endfor -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign swatch_img = shade.swatch_image.value -%}
              {%- assign model_img = shade.model_image.value -%}
              {%- assign shade_name = shade.name.value -%}
              {%- assign shade_desc = shade.description.value -%}

              <article
                class="shade-card"
                data-usage="{{ usage_data | strip }}"
                data-tone="{{ tone_value | downcase | strip }}"
                :class="{ 'is-hidden': !matches('{{ usage_data | strip }}', '{{ tone_value | downcase | strip }}') }"
              >
                <div class="shade-card__media">
                  {%- if swatch_img -%}
                    <img
                      class="shade-card__image shade-card__image--swatch"
                      src="{{ swatch_img | image_url: width: 800 }}"
                      srcset="{{ swatch_img | image_url: width: 400 }} 400w, {{ swatch_img | image_url: width: 600 }} 600w, {{ swatch_img | image_url: width: 800 }} 800w, {{ swatch_img | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 768px) 25vw, 85vw"
                      width="{{ swatch_img.width }}"
                      height="{{ swatch_img.height }}"
                      alt="{{ shade_name | escape }} swatch"
                      loading="lazy"
                      :style="view === 'swatches' ? 'opacity:1' : 'opacity:0'"
                    >
                  {%- endif -%}
                  {%- if model_img -%}
                    <img
                      class="shade-card__image shade-card__image--model"
                      src="{{ model_img | image_url: width: 800 }}"
                      srcset="{{ model_img | image_url: width: 400 }} 400w, {{ model_img | image_url: width: 600 }} 600w, {{ model_img | image_url: width: 800 }} 800w, {{ model_img | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 768px) 25vw, 85vw"
                      width="{{ model_img.width }}"
                      height="{{ model_img.height }}"
                      alt="{{ shade_name | escape }} on model"
                      loading="lazy"
                      :style="view === 'models' ? 'opacity:1' : 'opacity:0'"
                    >
                  {%- endif -%}
                </div>
                <h3 class="shade-card__name">{{ shade_name | escape }}</h3>
                {%- if shade_desc != blank -%}
                  <p class="shade-card__description">{{ shade_desc | newline_to_br }}</p>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="shade-finder__nav shade-finder__nav--next"
          aria-label="Next shades"
          @click="next()"
          x-show="showNav"
          :disabled="slide >= maxSlide"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="shade-finder__empty" x-show="visibleCount === 0" x-cloak>
          {{ section.settings.empty_state_text | escape }}
        </div>
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="shade-finder__setup-notice">
          Add entries to the <code>agent_shade</code> metaobject to populate this section.
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_find_my_shade_cta and section.settings.find_my_shade_url != blank -%}
      <div class="shade-finder__cta">
        <span class="shade-finder__cta-prompt">{{ section.settings.find_my_shade_prompt | escape }}</span>
        <a class="shade-finder__cta-button" href="{{ section.settings.find_my_shade_url }}">
          <span>{{ section.settings.find_my_shade_text | escape }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'section-what-shade-am-i.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "What Shade Am I?",
  "tag": "section",
  "class": "section-what-shade-am-i",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Shade Am I?"
    },
    {
      "type": "text",
      "id": "swatches_label",
      "label": "Swatches toggle label",
      "default": "Swatches"
    },
    {
      "type": "text",
      "id": "models_label",
      "label": "Models toggle label",
      "default": "Models"
    },
    {
      "type": "text",
      "id": "usage_label",
      "label": "Usage filter label",
      "default": "USAGE"
    },
    {
      "type": "text",
      "id": "skin_tone_label",
      "label": "Skin tone filter label",
      "default": "SKIN TONE"
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Empty state message",
      "default": "No shades match. Try 'All'."
    },
    {
      "type": "header",
      "content": "Find My Shade CTA"
    },
    {
      "type": "checkbox",
      "id": "show_find_my_shade_cta",
      "label": "Show Find My Shade CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "find_my_shade_prompt",
      "label": "CTA prompt text",
      "default": "Still Not Sure?"
    },
    {
      "type": "text",
      "id": "find_my_shade_text",
      "label": "CTA button text",
      "default": "FIND MY SHADE"
    },
    {
      "type": "url",
      "id": "find_my_shade_url",
      "label": "CTA URL",
      "default": "/pages/find-my-shade"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active pill / CTA color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Active pill / CTA text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "What Shade Am I?"
    }
  ]
}
{% endschema %}

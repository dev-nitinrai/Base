{%- liquid
  assign shade_blocks = section.blocks | where: 'type', 'shade_card'
  assign usage_filter_blocks = section.blocks | where: 'type', 'usage_filter'
  assign skin_tone_filter_blocks = section.blocks | where: 'type', 'skin_tone_filter'
-%}

<what-shade-am-i
  class="wsai"
  id="wsai-{{ section.id }}"
  style="
    --wsai-bg: {{ section.settings.bg_color }};
    --wsai-heading-color: {{ section.settings.heading_color }};
    --wsai-text-color: {{ section.settings.text_color }};
    --wsai-chip-active-bg: {{ section.settings.chip_active_bg }};
    --wsai-chip-active-text: {{ section.settings.chip_active_text }};
    --wsai-chip-inactive-bg: {{ section.settings.chip_inactive_bg }};
    --wsai-chip-inactive-text: {{ section.settings.chip_inactive_text }};
    --wsai-card-bg: {{ section.settings.card_bg_color }};
    --wsai-card-selected-border: {{ section.settings.card_selected_border }};
    --wsai-btn-bg: {{ section.settings.button_color }};
    --wsai-btn-text: {{ section.settings.button_text_color }};
    --wsai-card-radius: {{ section.settings.card_radius }}px;
    --wsai-swatch-size: {{ section.settings.swatch_size }}px;
    --wsai-pt: {{ section.settings.padding_top }}px;
    --wsai-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="wsai__inner">

    <div class="wsai__header">
      <div class="wsai__toggle-wrap">
        <span class="wsai__toggle-label" id="wsai-toggle-swatches-{{ section.id }}">{{ section.settings.toggle_label_swatches }}</span>
        <button
          class="wsai__toggle"
          role="switch"
          aria-checked="false"
          aria-labelledby="wsai-toggle-swatches-{{ section.id }} wsai-toggle-models-{{ section.id }}"
          data-wsai-toggle
        >
          <span class="wsai__toggle-thumb"></span>
        </button>
        <span class="wsai__toggle-label" id="wsai-toggle-models-{{ section.id }}">{{ section.settings.toggle_label_models }}</span>
      </div>

      <h2 class="wsai__heading">{{ section.settings.heading }}</h2>

      <div class="wsai__header-spacer" aria-hidden="true"></div>
    </div>

    <div class="wsai__filters">
      {%- if usage_filter_blocks.size > 0 -%}
        <div class="wsai__filter-row">
          <span class="wsai__filter-label">{{ section.settings.usage_label }}</span>
          <div class="wsai__chips" role="group" aria-label="{{ section.settings.usage_label }}">
            {%- for block in usage_filter_blocks -%}
              <button
                class="wsai__chip{% if forloop.first %} wsai__chip--active{% endif %}"
                data-wsai-usage="{{ block.settings.value }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if skin_tone_filter_blocks.size > 0 -%}
        <div class="wsai__filter-row">
          <span class="wsai__filter-label">{{ section.settings.skin_tone_label }}</span>
          <div class="wsai__chips" role="group" aria-label="{{ section.settings.skin_tone_label }}">
            {%- for block in skin_tone_filter_blocks -%}
              <button
                class="wsai__chip{% if forloop.first %} wsai__chip--active{% endif %}"
                data-wsai-skin-tone="{{ block.settings.value }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="wsai__carousel-wrap">
      <button class="wsai__nav wsai__nav--prev" aria-label="{{ 'sections.what_shade_am_i.prev_slide' | t }}" data-wsai-prev>
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none" aria-hidden="true">
          <path d="M9 1L1 9L9 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="wsai__carousel" data-wsai-carousel aria-live="polite" aria-label="{{ section.settings.heading }}">
        <div class="wsai__track" data-wsai-track>
          {%- for block in shade_blocks -%}
            <article
              class="wsai__card"
              data-wsai-card
              data-usage="{{ block.settings.usage }}"
              data-skin-tone="{{ block.settings.skin_tone }}"
              data-shade-id="{{ block.id }}"
              aria-label="{{ block.settings.shade_name }}"
              {{ block.shopify_attributes }}
            >
              <div class="wsai__card-media">
                {%- if block.settings.model_image != blank -%}
                  <img
                    src="{{ block.settings.model_image | image_url: width: 600 }}"
                    srcset="{{ block.settings.model_image | image_url: width: 400 }} 400w, {{ block.settings.model_image | image_url: width: 600 }} 600w, {{ block.settings.model_image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 80vw"
                    alt="{{ block.settings.model_image.alt | default: block.settings.shade_name | escape }}"
                    width="600"
                    height="720"
                    loading="lazy"
                    class="wsai__card-img wsai__card-img--model"
                  >
                {%- elsif block.settings.swatch_image != blank -%}
                  <img
                    src="{{ block.settings.swatch_image | image_url: width: 600 }}"
                    srcset="{{ block.settings.swatch_image | image_url: width: 400 }} 400w, {{ block.settings.swatch_image | image_url: width: 600 }} 600w"
                    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 80vw"
                    alt="{{ block.settings.swatch_image.alt | default: block.settings.shade_name | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                    class="wsai__card-img wsai__card-img--swatch"
                  >
                {%- else -%}
                  <div
                    class="wsai__card-swatch-placeholder"
                    style="background-color: {{ block.settings.color_hex }};"
                    aria-hidden="true"
                  ></div>
                {%- endif -%}
              </div>

              <div class="wsai__card-body">
                <h3 class="wsai__card-name">{{ block.settings.shade_name }}</h3>
                {%- if section.settings.show_shade_description and block.settings.description != blank -%}
                  <p class="wsai__card-desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- else -%}
            {%- if request.design_mode -%}
              <div class="wsai__empty-state">
                <p>{{ 'sections.what_shade_am_i.no_shades' | t }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <button class="wsai__nav wsai__nav--next" aria-label="{{ 'sections.what_shade_am_i.next_slide' | t }}" data-wsai-next>
        <svg width="10" height="18" viewBox="0 0 10 18" fill="none" aria-hidden="true">
          <path d="M1 1L9 9L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="wsai__footer">
        <span class="wsai__footer-label">{{ section.settings.cta_prefix }}</span>
        <a
          href="{{ section.settings.cta_url | default: '#' }}"
          class="wsai__cta-btn"
        >
          {{ section.settings.cta_text }}
          <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true">
            <path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</what-shade-am-i>

{% stylesheet %}
.wsai {
  display: block;
  background-color: var(--wsai-bg);
  padding-block: var(--wsai-pt) var(--wsai-pb);
  overflow: hidden;
}

.wsai__inner {
  max-width: 1400px;
  margin-inline: auto;
  padding-inline: 40px;
}

.wsai__header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  margin-block-end: 48px;
}

.wsai__toggle-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-self: start;
}

.wsai__toggle-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--wsai-text-color);
  letter-spacing: 0.01em;
  user-select: none;
}

.wsai__toggle {
  position: relative;
  width: 44px;
  height: 24px;
  background-color: #ccc;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  padding: 0;
  transition: background-color 0.2s ease;
  flex-shrink: 0;
}

.wsai__toggle[aria-checked="true"] {
  background-color: var(--wsai-chip-active-bg);
}

.wsai__toggle-thumb {
  position: absolute;
  top: 2px;
  inset-inline-start: 2px;
  width: 20px;
  height: 20px;
  background-color: #fff;
  border-radius: 50%;
  transition: transform 0.2s ease;
  pointer-events: none;
}

.wsai__toggle[aria-checked="true"] .wsai__toggle-thumb {
  transform: translateX(20px);
}

.wsai__heading {
  font-family: var(--font-heading-family, var(--font-body-family));
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 400;
  color: var(--wsai-heading-color);
  text-align: center;
  margin: 0;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.wsai__header-spacer {
  justify-self: end;
}

.wsai__filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16px 40px;
  align-items: center;
  margin-block-end: 40px;
}

.wsai__filter-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.wsai__filter-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--wsai-heading-color);
  white-space: nowrap;
}

.wsai__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.wsai__chip {
  min-height: 44px;
  padding-inline: 16px;
  padding-block: 10px;
  border: 1px solid var(--wsai-heading-color);
  border-radius: 4px;
  background-color: var(--wsai-chip-inactive-bg);
  color: var(--wsai-chip-inactive-text);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background-color 0.15s ease, color 0.15s ease;
  white-space: nowrap;
}

.wsai__chip--active,
.wsai__chip[aria-pressed="true"] {
  background-color: var(--wsai-chip-active-bg);
  color: var(--wsai-chip-active-text);
  border-color: var(--wsai-chip-active-bg);
}

.wsai__chip:focus-visible {
  outline: 2px solid var(--wsai-chip-active-bg);
  outline-offset: 2px;
}

.wsai__carousel-wrap {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0;
}

.wsai__nav {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--wsai-heading-color);
  z-index: 2;
  transition: opacity 0.2s ease;
  padding: 0;
}

.wsai__nav:disabled {
  opacity: 0.3;
  cursor: default;
}

.wsai__nav:focus-visible {
  outline: 2px solid var(--wsai-chip-active-bg);
  outline-offset: 2px;
  border-radius: 4px;
}

.wsai__carousel {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.wsai__track {
  display: flex;
  gap: 20px;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

.wsai__card {
  flex: 0 0 calc((100% - 60px) / 4);
  min-width: 0;
  background-color: var(--wsai-card-bg);
  border-radius: var(--wsai-card-radius);
  overflow: hidden;
  cursor: pointer;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.wsai__card--hidden {
  display: none;
}

.wsai__card--dimmed {
  opacity: 0.35;
  pointer-events: none;
}

.wsai__card-media {
  width: 100%;
  aspect-ratio: 5 / 6;
  overflow: hidden;
  background-color: #e8e4e0;
}

.wsai__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.wsai__card:hover .wsai__card-img {
  transform: scale(1.03);
}

.wsai__card-swatch-placeholder {
  width: 100%;
  height: 100%;
}

.wsai__card-body {
  padding: 16px 8px 20px;
  text-align: center;
}

.wsai__card-name {
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--wsai-heading-color);
  margin: 0 0 8px;
  line-height: 1.3;
}

.wsai__card-desc {
  font-size: 0.8125rem;
  color: var(--wsai-text-color);
  margin: 0;
  line-height: 1.5;
}

.wsai__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
  margin-block-start: 40px;
}

.wsai__footer-label {
  font-size: 0.9375rem;
  color: var(--wsai-text-color);
}

.wsai__cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding-inline: 20px;
  background-color: var(--wsai-btn-bg);
  color: var(--wsai-btn-text);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 2px;
  transition: opacity 0.2s ease;
}

.wsai__cta-btn:hover {
  opacity: 0.85;
}

.wsai__cta-btn:focus-visible {
  outline: 2px solid var(--wsai-btn-bg);
  outline-offset: 2px;
}

.wsai__empty-state {
  padding: 40px;
  text-align: center;
  color: var(--wsai-text-color);
  font-size: 0.875rem;
}

@media (max-width: 1024px) {
  .wsai__card {
    flex: 0 0 calc((100% - 40px) / 3);
  }
}

@media (max-width: 768px) {
  .wsai__inner {
    padding-inline: 20px;
  }

  .wsai__header {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
    margin-block-end: 32px;
  }

  .wsai__toggle-wrap {
    justify-self: start;
    order: 1;
  }

  .wsai__heading {
    order: 0;
    justify-self: center;
  }

  .wsai__header-spacer {
    display: none;
  }

  .wsai__filters {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-block-end: 24px;
  }

  .wsai__filter-row {
    width: 100%;
  }

  .wsai__chips {
    gap: 6px;
  }

  .wsai__chip {
    min-height: 44px;
    font-size: 0.6875rem;
    padding-inline: 12px;
  }

  .wsai__carousel-wrap {
    gap: 0;
  }

  .wsai__nav {
    display: none;
  }

  .wsai__carousel {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .wsai__carousel::-webkit-scrollbar {
    display: none;
  }

  .wsai__track {
    transition: none;
    gap: 12px;
    padding-inline: 4px;
  }

  .wsai__card {
    flex: 0 0 80vw;
    scroll-snap-align: start;
  }

  .wsai__footer {
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    margin-block-start: 24px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .wsai__track,
  .wsai__card,
  .wsai__card-img,
  .wsai__toggle-thumb {
    transition: none;
  }
}
{% endstylesheet %}

{% javascript %}
class WhatShadeAmI extends HTMLElement {
  connectedCallback() {
    this._track = this.querySelector('[data-wsai-track]');
    this._prevBtn = this.querySelector('[data-wsai-prev]');
    this._nextBtn = this.querySelector('[data-wsai-next]');
    this._toggleBtn = this.querySelector('[data-wsai-toggle]');
    this._usageChips = this.querySelectorAll('[data-wsai-usage]');
    this._skinToneChips = this.querySelectorAll('[data-wsai-skin-tone]');
    this._allCards = Array.from(this.querySelectorAll('[data-wsai-card]'));

    this._currentIndex = 0;
    this._activeUsage = 'all';
    this._activeSkinTone = 'all';
    this._isModelsView = false;
    this._visibleCards = [];

    this._onResize = this._onResize.bind(this);
    window.addEventListener('resize', this._onResize);

    if (this._prevBtn) this._prevBtn.addEventListener('click', () => this._slide(-1));
    if (this._nextBtn) this._nextBtn.addEventListener('click', () => this._slide(1));

    this._usageChips.forEach(chip => {
      chip.addEventListener('click', () => {
        this._activeUsage = chip.dataset.wsaiUsage;
        this._currentIndex = 0;
        this._setChipActive(this._usageChips, this._activeUsage, 'wsaiUsage');
        this._updateCarousel();
      });
    });

    this._skinToneChips.forEach(chip => {
      chip.addEventListener('click', () => {
        this._activeSkinTone = chip.dataset.wsaiSkinTone;
        this._currentIndex = 0;
        this._setChipActive(this._skinToneChips, this._activeSkinTone, 'wsaiSkinTone');
        this._updateCarousel();
      });
    });

    if (this._toggleBtn) {
      this._toggleBtn.addEventListener('click', () => {
        this._isModelsView = !this._isModelsView;
        this._toggleBtn.setAttribute('aria-checked', this._isModelsView ? 'true' : 'false');
        this._allCards.forEach(card => {
          const modelImg = card.querySelector('.wsai__card-img--model');
          const swatchImg = card.querySelector('.wsai__card-img--swatch');
          const placeholder = card.querySelector('.wsai__card-swatch-placeholder');
          if (this._isModelsView) {
            if (modelImg) modelImg.style.display = '';
            if (swatchImg) swatchImg.style.display = 'none';
            if (placeholder) placeholder.style.display = 'none';
          } else {
            if (modelImg) modelImg.style.display = 'none';
            if (swatchImg) swatchImg.style.display = '';
            if (placeholder) placeholder.style.display = '';
          }
        });
      });
    }

    this._updateCarousel();
  }

  disconnectedCallback() {
    window.removeEventListener('resize', this._onResize);
  }

  _getCardsPerView() {
    const w = window.innerWidth;
    if (w <= 768) return 1;
    if (w <= 1024) return 3;
    return 4;
  }

  _getVisibleCards() {
    return this._allCards.filter(card => {
      const usage = card.dataset.usage || 'all';
      const skinTone = card.dataset.skinTone || 'all';
      const usageMatch = this._activeUsage === 'all' || usage === this._activeUsage || usage === 'all';
      const skinToneMatch = this._activeSkinTone === 'all' || skinTone === this._activeSkinTone || skinTone === 'all';
      return usageMatch && skinToneMatch;
    });
  }

  _updateCarousel() {
    this._visibleCards = this._getVisibleCards();
    const perView = this._getCardsPerView();

    this._allCards.forEach(card => {
      card.classList.toggle('wsai__card--hidden', !this._visibleCards.includes(card));
    });

    this._currentIndex = Math.min(this._currentIndex, Math.max(0, this._visibleCards.length - perView));
    this._applyTransform();
    this._updateNavState();
  }

  _applyTransform() {
    if (!this._track || window.innerWidth <= 768) return;
    const perView = this._getCardsPerView();
    const gap = 20;
    const trackParentWidth = this._track.parentElement.offsetWidth;
    const cardWidth = (trackParentWidth - gap * (perView - 1)) / perView;
    const offset = this._currentIndex * (cardWidth + gap);
    this._track.style.transform = `translateX(-${offset}px)`;
  }

  _updateNavState() {
    const perView = this._getCardsPerView();
    if (this._prevBtn) this._prevBtn.disabled = this._currentIndex <= 0;
    if (this._nextBtn) this._nextBtn.disabled = this._currentIndex >= this._visibleCards.length - perView;
  }

  _slide(direction) {
    const perView = this._getCardsPerView();
    const newIndex = this._currentIndex + direction;
    if (newIndex < 0 || newIndex > this._visibleCards.length - perView) return;
    this._currentIndex = newIndex;
    this._applyTransform();
    this._updateNavState();
  }

  _setChipActive(chips, value, dataKey) {
    chips.forEach(chip => {
      const isActive = chip.dataset[dataKey] === value;
      chip.classList.toggle('wsai__chip--active', isActive);
      chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  _onResize() {
    this._applyTransform();
    this._updateNavState();
  }
}

customElements.define('what-shade-am-i', WhatShadeAmI);
{% endjavascript %}

{% schema %}
{
  "name": "What Shade Am I?",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Shade Am I?"
    },
    {
      "type": "text",
      "id": "toggle_label_swatches",
      "label": "Toggle label — swatches",
      "default": "Swatches"
    },
    {
      "type": "text",
      "id": "toggle_label_models",
      "label": "Toggle label — models",
      "default": "Models"
    },
    {
      "type": "text",
      "id": "usage_label",
      "label": "Usage filter label",
      "default": "USAGE"
    },
    {
      "type": "text",
      "id": "skin_tone_label",
      "label": "Skin tone filter label",
      "default": "SKIN TONE"
    },
    {
      "type": "text",
      "id": "cta_prefix",
      "label": "CTA prefix text",
      "default": "Still Not Sure?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "FIND MY SHADE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    },
    {
      "type": "checkbox",
      "id": "show_shade_description",
      "label": "Show shade description",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
